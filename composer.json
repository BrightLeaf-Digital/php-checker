{
  "name": "brightleaf-digital/php-compatibility-scanner",
  "repositories": {
    "gravityops-local": {
      "type": "path",
      "url": "../../../gravityops",
      "options": {
        "symlink": true
      }
    },
    "gravityops-remote": {
      "type": "vcs",
      "url": "git@github.com:BrightLeaf-Digital/gravityops.git",
      "no-api": true
    }
  },
  "require": {
    "gravityops/core": "2.1.0",
    "squizlabs/php_codesniffer": "^3.11",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
    "wp-coding-standards/wpcs": "^3.3",
    "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2"
  },
  "require-dev": {
    "gravityops/core": "dev-main as 2.1.0"
  },
  "scripts": {
    "cleanup-vendor": [
      "@php tools/cleanup-vendor.php"
    ],
    "post-install-cmd": [
      "@cleanup-vendor"
    ],
    "post-update-cmd": [
      "@cleanup-vendor"
    ]
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor/GOPCS",
      "namespace_prefix": "GOPCS\\",
      "classmap_prefix": "GOPCS_",
      "constant_prefix": "GOPCS_",
      "packages": [
        "gravityops/core",
        "trustedlogin/client",
        "league/commonmark",
        "league/config",
        "dflydev/dot-access-data",
        "nette/schema",
        "nette/utils",
        "psr/event-dispatcher",
        "symfony/deprecation-contracts",
        "symfony/polyfill-php80"
      ],
      "delete_vendor_packages": true,
      "update_call_sites": [
        "class-brightleaf-digital-php-checker-plugin.php"
      ],
      "exclude_from_copy": {
        "file_patterns": [
          "(^|/)\\.git(/|$)",
          "(^|/)\\.github(/|$)",
          "\\.git(ignore|modules|attributes)$",
          "(^|/)tests(/|$)"
        ]
      }
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "preferred-install": {
      "gravityops/core": "source",
      "*": "dist"
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
